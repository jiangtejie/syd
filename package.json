{
  "name": "wechat-cs-desktop",
  "version": "1.0.0",
  "description": "An Electron application with React and TypeScript",
  "main": "./out/main/index.js",
  "author": "example.com",
  "homepage": "https://electron-vite.org",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "test:similarity": "node --experimental-strip-types scripts/issue-similarity-selftest.mjs",
    "test:schema": "node scripts/schema-migration-selftest.mjs",
    "test:matcher": "node scripts/reply-matcher-selftest.mjs",
    "test:lark": "node --experimental-strip-types scripts/lark-sync-selftest.mjs",
    "test:registry": "node --experimental-strip-types scripts/tool-registry-selftest.mjs",
    "test:timeline": "node --experimental-strip-types scripts/tool-timeline-selftest.mjs",
    "test:monitor": "node --experimental-strip-types scripts/monitor-selection-selftest.mjs && node --experimental-strip-types scripts/intent-selftest.mjs",
    "test:digest": "node --experimental-strip-types scripts/digest-selftest.mjs",
    "test:send": "node --experimental-strip-types scripts/send-guard-selftest.mjs",
    "test:crypto": "node scripts/wx-crypto-selftest.mjs",
    "test:media-proto": "node scripts/media-proto-selftest.mjs",
    "test:media-cache": "node scripts/media-cache-selftest.mjs",
    "test:asr": "node scripts/asr-tencent-selftest.mjs",
    "test:win": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/wechat-window-selftest.ps1 && powershell -NoProfile -ExecutionPolicy Bypass -File scripts/wechat-ocr-selftest.ps1",
    "test:all": "npm run test:schema && npm run test:crypto && npm run test:media-proto && npm run test:media-cache && npm run test:asr && npm run test:matcher && npm run test:lark && npm run test:registry && npm run test:timeline && npm run test:digest && npm run test:send && npm run test:feedback && npm run test:monitor",
    "test:feedback": "node --experimental-strip-types scripts/reply-attribution-selftest.mjs && node --experimental-strip-types scripts/text-filters-selftest.mjs && node --experimental-strip-types scripts/issue-similarity-selftest.mjs",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "postinstall": "electron-builder install-app-deps",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "npm run build && electron-builder --win",
    "build:win:offline": "npm run build && electron-builder --win --config electron-builder.offline.yml",
    "build:mac": "electron-vite build && electron-builder --mac",
    "build:linux": "electron-vite build && electron-builder --linux"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^3.0.43",
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@larksuiteoapi/node-sdk": "^1.73.3",
    "ai": "^7.0.91",
    "better-sqlite3-multiple-ciphers": "^13.0.3",
    "echarts": "^6.1.0",
    "exceljs": "^4.4.0",
    "fzstd": "^0.1.1",
    "pg": "^8.23.0",
    "qrcode": "^1.5.4",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "silk-wasm": "^3.7.1",
    "zod": "^4.5.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@types/node": "^22.19.1",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "electron": "^39.2.6",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "prettier": "^3.7.4",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "typescript": "^5.9.3",
    "vite": "^7.2.6"
  }
}
